# PostgreSQL (never commit a populated .env.local)
DATABASE_URL="postgresql://linkconnect:change-me@localhost:5432/linkconnect?schema=public"

# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET="replace-with-at-least-32-random-bytes"
# Generate with: openssl rand -base64 32
# Base64-encoded 32-byte key used to encrypt API-key HMAC secrets at rest.
DATA_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"

# Public application origin, used for Stripe portal return URLs.
APP_URL="http://localhost:3000"
# Vercel Cron / outbox worker bearer secret (at least 32 random characters).
CRON_SECRET="replace-with-a-random-cron-secret"

# Stripe server credentials. SEPA mandates are created and stored by Stripe only.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Optional transactional email via Resend. No email is simulated when omitted.
RESEND_API_KEY="re_replace_me"
EMAIL_FROM="LinkConnect <meldingen@example.nl>"
